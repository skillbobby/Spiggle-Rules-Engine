{
    "name": "spiggle/rules-engine",
    "description": "Tenant-scoped Filament rules engine with preset triggers, idempotent execution, and audit logs.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "rules-engine",
        "automation",
        "spiggle"
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3|^4.0|^5.0",
        "illuminate/database": ">=11.0",
        "illuminate/support": ">=11.0"
    },
    "autoload": {
        "psr-4": {
            "Spiggle\\RulesEngine\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spiggle\\RulesEngine\\RulesEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
